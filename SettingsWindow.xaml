
<Window x:Class="HeadsetMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="760"
        Width="520"
        MinHeight="600"
        MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#101116"/>
        <SolidColorBrush x:Key="WindowForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1D25"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9295A5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>

        <SolidColorBrush x:Key="ComboBackground" Color="#252733"/>
        <SolidColorBrush x:Key="ComboBorder" Color="#514B78"/>
        <SolidColorBrush x:Key="ComboHighlight" Color="#514B78"/>
        <SolidColorBrush x:Key="ComboSelected" Color="#7565E8"/>
        <SolidColorBrush x:Key="ComboHighlightForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ComboSelectedForeground" Color="#FFFFFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource WindowForeground}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource WindowForeground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>

        <Style x:Key="SettingsComboBoxItem"
               TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground"
                    Value="{DynamicResource WindowForeground}"/>
            <Setter Property="Background"
                    Value="{DynamicResource ComboBackground}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ComboHighlight}"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource ComboHighlightForeground}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ComboSelected}"/>
                    <Setter Property="Foreground"
                            Value="{DynamicResource ComboSelectedForeground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background"
                    Value="{DynamicResource ComboBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource WindowForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ComboBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource SettingsComboBoxItem}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource ComboBackground}"
                                          BorderBrush="{DynamicResource ComboBorder}"
                                          BorderThickness="1">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{DynamicResource WindowForeground}"
                                                      StrokeThickness="1.7"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="11,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource WindowForeground}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">

                                <Border Background="{DynamicResource ComboBackground}"
                                        BorderBrush="{DynamicResource ComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer MaxHeight="190"
                                                  CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#7565E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="НАСТРОЙКИ"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="Параметры приложения"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Margin="0,5,0,0"/>

            <TextBlock Text="Настрой работу Headset Monitor под себя"
                       FontSize="12"
                       Foreground="{DynamicResource MutedBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- APPEARANCE -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="ВНЕШНИЙ ВИД"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Text="Тема приложения"
                                   FontSize="13"
                                   Margin="0,12,0,0"/>

                        <ComboBox x:Name="ThemeComboBox">
                            <ComboBoxItem Content="Тёмная"/>
                            <ComboBoxItem Content="Светлая"/>
                            <ComboBoxItem Content="Как в Windows"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- STARTUP -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="ЗАПУСК И ПОВЕДЕНИЕ"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Запускать вместе с Windows"/>

                        <CheckBox x:Name="StartMinimizedCheckBox"
                                  Content="Запускать сразу свёрнутым в трей"/>

                        <CheckBox x:Name="MinimizeToTrayCheckBox"
                                  Content="Сворачивать в трей при нажатии на крестик"/>

                        <TextBlock Text="Обычная кнопка сворачивания оставляет приложение на панели задач."
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>

                <!-- NOTIFICATIONS -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="УВЕДОМЛЕНИЯ"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox x:Name="LowBatteryCheckBox"
                                  Content="Уведомлять о низком заряде"/>

                        <TextBlock Text="Порог низкого заряда"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,5,0,0"/>

                        <ComboBox x:Name="LowBatteryThresholdComboBox">
                            <ComboBoxItem Content="10%" Tag="10"/>
                            <ComboBoxItem Content="15%" Tag="15"/>
                            <ComboBoxItem Content="20%" Tag="20"/>
                            <ComboBoxItem Content="25%" Tag="25"/>
                        </ComboBox>

                        <CheckBox x:Name="TrayPercentageCheckBox"
                                  Content="Показывать процент заряда в трее"/>
                    </StackPanel>
                </Border>

                <!-- ADDITIONAL -->
                <Border Background="{DynamicResource PanelBrush}"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="ДОПОЛНИТЕЛЬНО"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox x:Name="TechnicalInfoCheckBox"
                                  Content="Показывать техническую USB-информацию"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Отмена"
                    Click="CancelButton_Click"
                    Background="{DynamicResource ComboBackground}"
                    Foreground="{DynamicResource WindowForeground}"
                    BorderBrush="{DynamicResource ComboBorder}"
                    BorderThickness="1"
                    Height="38"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Cursor="Hand"/>

            <Button Content="Сохранить"
                    Style="{StaticResource ActionButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
